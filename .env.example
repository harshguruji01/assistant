# =====================================================================
# FALCON AI DESKTOP ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Developed by: HarshGuruJi
# =====================================================================

# ----------------- AI Provider Configuration -----------------
# Choose from: nvidia, ollama, openai, gemini, anthropic, mock
FALCON_AI_PROVIDER=nvidia
FALCON_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# NVIDIA NIM API (integrate.api.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Local Ollama Inference Server (Default Windows port: 11434)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud AI Keys (Never commit real keys into source control!)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ----------------- Voice Configuration -----------------------
# Set to 'false' to run in silent/text-only mode
FALCON_VOICE_ENABLED=true
FALCON_VOICE_LANG=hi-IN

# STT Providers: vachana, speech_recognition, disabled
FALCON_STT_PROVIDER=vachana
# TTS Providers: vachana, sarvam, pyttsx3, windows_sapi
FALCON_TTS_PROVIDER=vachana

# Gnani.ai / Vachana Voice AI (Both STT + TTS)
VACHANA_API_KEY=
VACHANA_TTS_VOICE=Devansh
VACHANA_TTS_MODEL=timbre-v3.0
VACHANA_STT_MODEL=gnani-prisma-v2.5

# Sarvam AI Text-to-Speech (High quality Indian voices: Aditya, Ishita, etc.)
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=aditya
SARVAM_TTS_MODEL=bulbul:v3

# ----------------- Logging & Security ------------------------
# Log levels: DEBUG, INFO, WARNING, ERROR
FALCON_LOG_LEVEL=INFO

# Require explicit user confirmation for high-risk tools (file delete, process kill)
FALCON_REQUIRE_APPROVAL=true
